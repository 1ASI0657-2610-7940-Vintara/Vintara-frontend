# # Environment: Development
# # Description: Environment variables for development environment
# # Note: Do not commit sensitive information to version control
# # Local Development Base URLs (Using Vite proxy to avoid CORS issues)
# VITE_AUTH_API_URL="/api/v1"
# VITE_INVENTORY_API_URL="/api/v1"
# VITE_PURCHASE_API_URL="/api/v1"
# VITE_PROFILES_API_URL="/api/v1"
# VITE_ANALYTICS_API_URL="/api/v1"

# # Or if you want to bypass the Vite proxy and hit services directly (requires backend CORS configured):
# # VITE_AUTH_API_URL="http://localhost:5001/api/v1"
# # VITE_INVENTORY_API_URL="http://localhost:5002/api/v1"
# # VITE_PURCHASE_API_URL="http://localhost:5003/api/v1"
# # VITE_PROFILES_API_URL="http://localhost:5004/api/v1"
# # VITE_ANALYTICS_API_URL="http://localhost:5005/api/v1"

# # Endpoint Sub-Paths
# VITE_SUPPLIES_ENDPOINT_PATH="/inventory/supplies"
# VITE_STOCK_MOVEMENTS_ENDPOINT_PATH="/inventory/stock-movements"
# VITE_ANALYTICS_ENDPOINT_PATH="/analytics"
# VITE_REPORTS_ENDPOINT_PATH="/analytics/reports"
# VITE_PURCHASE_ORDERS_ENDPOINT_PATH="/purchase-orders"
# VITE_PROFILES_ENDPOINT_PATH="/profiles"
# VITE_SENSOR_ALERTS_ENDPOINT_PATH="/sensor-alerts"

# # Mock Admin Credentials (for development and local testing purposes only)
# VITE_DEFAULT_ADMIN_EMAIL="admin@winesoft.com"
# VITE_DEFAULT_ADMIN_PASSWORD="123456"

VITE_API_BASE_URL="/api"

VITE_AUTH_ENDPOINT_PATH="/auth"
VITE_SUPPLIES_ENDPOINT_PATH="/inventory/supplies"
VITE_STOCK_MOVEMENTS_ENDPOINT_PATH="/inventory/stock-movements"
VITE_ANALYTICS_ENDPOINT_PATH="/analytics"
VITE_REPORTS_ENDPOINT_PATH="/analytics/reports"
VITE_PURCHASE_ORDERS_ENDPOINT_PATH="/purchase-orders"
VITE_PROFILES_ENDPOINT_PATH="/profiles"
VITE_SENSOR_ALERTS_ENDPOINT_PATH="/inventory/sensor-alerts"